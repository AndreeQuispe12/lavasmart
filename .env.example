# Copiar a web/.env.local (ahí la lee Next.js) y completar. Este archivo SÍ se
# versiona; .env.local NO. Las privadas no van en web/: solo las usa ml/.

# Públicas: quedan incrustadas en el código que descarga el navegador.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Privadas: nunca deben llevar el prefijo NEXT_PUBLIC_ ni subirse al repositorio.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
